@inject RackClient Client
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="modal fade" id="@GetModalId(rack)" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">@title</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal" @onclick="@ConfirmAsync">Delete</button>
      </div>
    </div>
  </div>
</div>

@code {
    [Parameter]
    public RackSummary? rack {get;set;}

    private string title = string.Empty;

    protected override void OnParametersSet()
    {
        title = $"Delete {rack?.Name}?";
    }

    public static string GetModalId(RackSummary? rack)
    {
        ArgumentNullException.ThrowIfNull(rack);
        return $"deleteRackModal-{rack.Id}";
    }

    private async Task ConfirmAsync()
    {
      await Client.DeleteRackAsync(rack!.Id);
      NavigationManager.Refresh(true);
    }
}
