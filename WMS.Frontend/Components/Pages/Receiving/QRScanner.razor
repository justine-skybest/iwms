@using WMS.Frontend.Models
@using BlazorBarcodeScanner.ZXing.JS
@inject NavigationManager NavigationManager
@rendermode InteractiveServer

<div class="modal fade" id="QRScanner" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h1 class="modal-title fs-5" id="exampleModalLabel">QR Scanner</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
            <div class="col">
              <BlazorBarcodeScanner.ZXing.JS.BarcodeReader
                  Title="Scan QR Code from Camera"
                  StartCameraAutomatically="false"    
                  ShowStart="true"
                  ShowStop="true"
                  ShowResult="false"
                  ShowReset="false"         
                  ShowToggleTorch = "false" 
                  ShowVideoDeviceList="true"
                  VideoWidth="450"
                  VideoHeight="400"                  
              />
            </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
