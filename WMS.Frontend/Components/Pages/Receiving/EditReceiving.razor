.796-1.892-.541-.11-1.07.238-1.181.779-.11.541.239 1.07.779 1.181.622.127 1.17.554 1.591 1.123.329.443.956.536 1.399.208.444-.329.537-.956.208-1.399z"></path></g><path d="m30.933 6.831c1.082-6.127 10.459-5.731 5 0z" fill="url(#_Linear18)"></path><path d="m30.933 8.383c1.082 6.126 10.459 5.731 5 0z" fill="url(#_Linear19)"></path><path d="m30.843 8.617h6.696c.552 0 1-.448 1-1s-.448-1-1-1h-6.696c-.551 0-1 .448-1 1s.449 1 1 1z" fill="url(#_Linear9)"></path></g></svg>
                            </div>
                        </GridEmptyDataTemplate>
                    </GridTemplates>
                </Grid>
                <ValidationMessage For="() => receiving.Products" />
            </div>
        </fieldset>

         <fieldset class="border border-1 rounded row p-2  mb-3">    
            <div class="col-md">
                <div class = "mb-2">
                    <label for="PlateNumber" class="form-label">Plate No.:</label>
                    <InputText id="PlateNumber" @bind-Value="receiving.PlateNumber" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.PlateNumber"/>
                </div>
                <div class="mb-2">
                    <label for="DriverName" class="form-label">Driver:</label>
                    <InputText id="DriverName" @bind-Value="receiving.DriverName" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.DriverName"/>
                </div>
                <div class="mb-2">
                    <label for="DateTime" class="form-label">Date-Time:</label>
                    <InputDate Type="InputDateType.DateTimeLocal" id="DateTime" @bind-Value="receiving.DateTime" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.DateTime"/>
                </div>
            </div>
             <div class="col-md">
                <div class = "mb-2">
                    <label for="ClientRepresentative" class="form-label">Shipper Representative</label>
                     <InputText id="ClientRepresentative" @bind-Value="receiving.ClientRepresentative" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.ClientRepresentative"/>
                </div>
                <div class = "mb-2">
                    <label for="CheckerName" class="form-label">Checker</label>
                     <InputText id="CheckerName" @bind-Value="receiving.CheckerName" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.CheckerName"/>
                </div>
                <div class="row">
                    <div class="col-md mb-2">
                        <label for="TimeIn" class="form-label">Time In</label>
                        <InputDate Type="InputDateType.DateTimeLocal" id="TimeIn" @bind-Value="receiving.TimeStart" class="form-control"  onkeypress="return event.keyCode!=13"/>
                        <ValidationMessage For="() => receiving.TimeStart" />
                    </div>
                    <div class="col-md  mb-2">
                        <label for="TimeOut" class="form-label">Time Out</label>
                        <InputDate Type="InputDateType.DateTimeLocal" id="TimeOut" @bind-Value="receiving.TimeEnd" class="form-control"  onkeypress="return event.keyCode!=13"/>
                        <ValidationMessage For="() => receiving.TimeEnd" />
                    </div>
                </div>                
            </div>
        </fieldset>
        <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 mb-3">
            <button type="submit" class="btn btn-primary">Save</button>
            <a role="button" class="btn btn-secondary" href="/receiving">Cancel</a>
        </div>        
    </EditForm>

    <Modal @ref="QRScanner"
       title="QR Scanner"
       UseStaticBackdrop="true" 
       CloseOnEscape="false">
        <BodyTemplate>
            <BlazorBarcodeScanner.ZXing.JS.BarcodeReader
                    Title="Scan QR Code from Camera"
                    StartCameraAutomatically="true"    
                    ShowStart="false"
                    ShowStop="false"
                    ShowResult="false"
                    ShowReset="false"         
                    ShowToggleTorch = "false" 
                    ShowVideoDeviceList="true"
                    VideoWidth="300"
                    VideoHeight="200"
                    OnBarcodeReceived="OnScanned"

            />
            @if(!String.IsNullOrWhiteSpace(OnScannedText))
                {   
                    <div class="col pt-3">
                        <Alert Color="AlertColor.Danger"> <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>@OnScannedText</Alert>
                    </div>
                }
        </BodyTemplate>

    </Modal>
}

@code {
    [Parameter]
    public int? Id {get;set;}
    [Parameter]
    public int WarehouseId {get;set;}
    
    [SupplyParameterFromForm]
    private ReceivingDetails? receiving {get;set;}

    private string title = string.Empty;

    DateTime datetoMax = DateTime.Now.AddDays(60);
    DateTime datetoMin = DateTime.Now;

    private IEnumerable<ProductSummary> Products = default!;
    
    private ProductSummary? Product {get;set;}

    Grid<ReceivedProductSummary> ProductGrid = default!;

    private List<ReceivedProductSummary> SelectedProductGrid = new List<ReceivedProductSummary>();
    
    private ReceivedProductDetails? SelectedProduct {get;set;}    
    
    private List<PalletDetails> pallets = new List<PalletDetails>();
    
    private string PalletNumbers = string.Empty;

    private Modal QRScanner = default!;

    private string? DisplayError {get;set;}

    private WarehouseDetails? warehouse{get; set;}

    private string SelectedCheckInType { get; set;} = "Pallet";

    private bool IsBoxed { get; set;}

    private string? OnScannedText {get;set;}

    private bool IsLoading {get;set;} = false;


    protected async override Task OnParametersSetAsync()
    {
        if(receiving is not null)
        {
                return;
        }
        
        if (Id is not null)
        {
            receiving = await ReceivingClient.GetReceivingAsync(Id.Value);
            warehouse = await WarehouseClient.GetWarehouseAsync(Convert.ToInt32(receiving.WarehouseId));
            foreach(var palletID in receiving.Products.Select(product => product.PalletId))
            {
                if (int.TryParse(palletID, out int palletId))
                {
                    PalletDetails existPallet = await PalletClient.GetPalletAsync(palletId);
                    if(existPallet.Id != 0 && existPallet.PalletNumber != 0 && existPallet.PalletHashCode != 0 && !pallets.Any(p => p.Id == existPallet.Id))
                    {
                        pallets.Add(existPallet);
                        PalletNumbers = string.Join(",", pallets.Select(p => p.PalletNumber).OrderBy(p => p));        
                    }
                }
            }
            var summaries = await Task.WhenAll(receiving.Products.Select(product => product.ToSummaryAsync(ProductClient, PalletClient)));
            SelectedProductGrid = summaries.ToList();
            title = $"Edit {receiving.Series}";
        }
        else{
            warehouse = await WarehouseClient.GetWarehouseAsync(WarehouseId);
            receiving = new ()
            {
                WarehouseId = warehouse.Id.ToString(),
                Series = "SLCWH-00001-24",
                TransportCompany = string.Empty,
                Shipper = string.Empty,   
                Consignee = string.Empty,
                DateReceived = DateTime.Now,
                Reference = string.Empty,
                Products = new List<ReceivedProductDetails>(),            
                PlateNumber = string.Empty,
                DriverName = string.Empty,
                ClientRepresentative = string.Empty,      
                CheckerName = string.Empty,                
                DateTime = DateTime.Now,
                TimeStart = DateTime.Now,
                TimeEnd = DateTime.Now        
            };            
            title = "New Receiving";
        }

        ResetSelectedProduct();
    }
    
    private async Task HandleSubmitAsync()
    {
        ArgumentNullException.ThrowIfNull(receiving);

        try
        {
            IsLoading = true;
            DisplayError = null;   // clear previous error
            StateHasChanged();

            if (Id is null)
            {
                int SeriesNumber = 0;
                var TwoDigitYear = DateTime.Now.ToString("yy");
                var series = await ReceivingClient.GetReceivingSeriesAsync();

                if (!string.IsNullOrWhiteSpace(series) && !series.Equals("No series found"))
                {
                    SeriesNumber = int.Parse(series.Replace("SLCWH-", "").Replace($"-{TwoDigitYear}", ""));
                    SeriesNumber++;
                }
                else
                {
                    SeriesNumber = 1;
                }

                receiving.Series = $"SLCWH-{SeriesNumber.ToString("D5")}-{TwoDigitYear}";
                receiving.DateAdded = DateTime.Now;
                await ReceivingClient.AddReceivingAsync(receiving);
            }
            else
            {
                receiving.DateAdded = DateTime.Now;
                await ReceivingClient.UpdateReceivingAsync(receiving);
            }

            navigationManager.NavigateTo("receiving");
        }
        catch (Exception ex)
        {
            DisplayError = $"Error saving receiving: {ex.Message}";
            IsLoading = false;    // Re-enable button
            StateHasChanged();

            await Task.Delay(2000);  // Show error for 2 seconds
            DisplayError = null;
            StateHasChanged();
        }
    }
    private async Task<AutoCompleteDataProviderResult<ProductSummary>> ProductsDataProvider(AutoCompleteDataProviderRequest<ProductSummary> request)
    {
        Products = await ProductClient.GetProductsAsync(request.Filter.Value);
        return await Task.FromResult(new AutoCompleteDataProviderResult<ProductSummary> { Data = Products, TotalCount = Products.Count() });
    }

    private void OnAutoCompleteChanged(ProductSummary product)
    {
        if(SelectedProduct is null || product is null)
        {
            ResetSelectedProduct();
        }
        else if(product is not null){
            SelectedProduct.ProductId = product.Id;        
            Product = product;
            Product.Weight = Math.Round(Product.Weight,2);
        }    
    }

    private  void OnQuantityChanged(int Quantity)
    {
        if(SelectedProduct is not null && Product is not null)
        {
            SelectedProduct.Quantity = Quantity;
            if(!IsBoxed){
                SelectedProduct.TotalWeight = (Quantity * Product.Weight).ToString("N2");
                if (!String.IsNullOrWhiteSpace(Product.Measurement))
                {
                    var Measurements = Product.Measurement.Replace(" ", "");
                    var result = Measurements.Contains("X") ? Measurements.Split("X") : new string[0];
                    decimal Dimension = 1;
                    foreach (string Measurement in result)
                    {
                        if (decimal.TryParse(Measurement, out decimal value))
                        {
                            Dimension = Dimension * value;
                        }
                    }
                    SelectedProduct.CBM = ((Dimension * Quantity) / 1000000).ToString("N2");
                }
            }
        }
    }

    private void IsItemBoxedCheckChanged(bool value)
    {
        IsBoxed = value;
        if(SelectedProduct is not null)
        {
            SelectedProduct.ContainerName = String.Empty;
            SelectedProduct.CBM = String.Empty;
            SelectedProduct.TotalWeight = String.Empty;
        }
    }


    private async Task AppendSelectedProduct()
    {
        if(SelectedProduct is not null && receiving is not null && Product is not null)
        {
            if(SelectedProduct.ProductId != 0 && SelectedProduct.Quantity != 0 && SelectedProduct.ExpirationDate >= DateOnly.FromDateTime(DateTime.Now) && !String.IsNullOrWhiteSpace(SelectedProduct.CBM) && !String.IsNullOrEmpty(SelectedProduct.TotalWeight) && (!String.IsNullOrWhiteSpace(SelectedProduct.PalletId) || (IsIndividualItemSelected && (IsBoxed ? !String.IsNullOrEmpty(SelectedProduct.ContainerName) : true))) && !String.IsNullOrWhiteSpace(SelectedProduct.Remarks))
            {                                      
                if(IsPalletSelected)
                {
                    PalletDetails selectedPallet = await PalletClient.GetPalletAsync(Convert.ToInt32(SelectedProduct.PalletId));
                    SelectedProductGrid.Add(new ReceivedProductSummary(){
                        Id = Product.Id,
                        Name = Product.Name,
                        TypeOfPackage = Product.TypeOfPackage,
                        Measurement = Product.Measurement,
                        Weight = Product.Weight,
                        Quantity = SelectedProduct.Quantity,
                        CBM = Convert.ToDecimal(SelectedProduct.CBM).ToString("N2"),
                        TotalWeight = Convert.ToDecimal(SelectedProduct.TotalWeight).ToString("N2"),
                        ExpirationDate = SelectedProduct.ExpirationDate,
                        ContainerName = "",
                        PalletId = $"Pallet #{selectedPallet.PalletNumber}",     
                        Remarks = SelectedProduct.Remarks
                    });
                }
                else{
                    SelectedProductGrid.Add(new ReceivedProductSummary(){
                        Id = Product.Id,
                        Name = Product.Name,
                        TypeOfPackage = Product.TypeOfPackage,
                        Measurement = Product.Measurement,
                        Weight = Product.Weight,
                        Quantity = SelectedProduct.Quantity,
                        CBM = Convert.ToDecimal(SelectedProduct.CBM).ToString("N2"),
                        TotalWeight = Convert.ToDecimal(SelectedProduct.TotalWeight).ToString("N2"),
                        ExpirationDate = SelectedProduct.ExpirationDate,
                        ContainerName = !String.IsNullOrEmpty(SelectedProduct.ContainerName) ? SelectedProduct.ContainerName : "",
                        PalletId = "Individiual Item(s)",     
                        Remarks = SelectedProduct.Remarks
                    });
                    SelectedProduct.PalletId = null;
                }
                                             
                receiving.Products.Add(SelectedProduct);
                await ProductGrid.RefreshDataAsync();
                ResetSelectedProduct();
            }    
            else{
                DisplayError = "Input that has '*' should be fill-up.";
                await Task.Delay(2000);                
            }       
            DisplayError = "";
        }
    }

    private void ResetSelectedProduct()
    {
        IsBoxed = false;
        SelectedProduct = new(){                        
            CBM = string.Empty,
            TotalWeight = string.Empty,
            ExpirationDate = DateOnly.FromDateTime(DateTime.Now),
            Remarks = string.Empty,
            ContainerName = string.Empty,
            PalletId = string.Empty        
        };
        Product = new(){
                Name = string.Empty,
                TypeOfPackage = string.Empty,
                Measurement = string.Empty
        };
    }    

    private async Task GetDeleteModalId(ReceivedProductSummary product)
    {
        if(receiving is not null)
        {
            SelectedProductGrid.Remove(product);
            receiving.Products = SelectedProductGrid.Select(products => products.ToDetails()).ToList();            
            await ProductGrid.RefreshDataAsync();  
        }
    }   

    private async Task GeneratePallet()
    {
        pallets.Add(await PalletClient.AutomaticAddPalletAsync(WarehouseId));
        PalletNumbers = string.Join(",", pallets.Select(p => p.PalletNumber).OrderBy(p => p));
    }

    private async void OnScanned(BarcodeReceivedEventArgs args)
    {
        if (int.TryParse(args.BarcodeText, out int palletNumber))
        {
            PalletDetails existingPallet = await PalletClient.GetPalletByHashCodeAsync(palletNumber, WarehouseId);
            if(existingPallet.Id == 0 && existingPallet.PalletNumber == 0 && existingPallet.PalletHashCode == 0)
            {
                OnScannedText = existingPallet.PalletDimension; //The variable PalletDimension was used to store the message from the api.
            }
            else if(pallets.Any(p => p.Id == existingPallet.Id))
            {
                OnScannedText = "This QR Code is already scanned and available as an option in the pallet selection.";          
            }
            else{
                OnScannedText = "";
                pallets.Add(existingPallet);
                PalletNumbers = string.Join(",", pallets.Select(p => p.PalletNumber).OrderBy(p => p));        
                await QRScanner.HideAsync();
                StateHasChanged();
            } 
        }        
    }

    private async Task OnShowModalClick()
    {
        await QRScanner.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await QRScanner.HideAsync();
    }


    private bool IsPalletSelected
    {
        get => SelectedCheckInType == "Pallet";
        set
        {
            if (value) SelectedCheckInType = "Pallet";
        }
    }

    private bool IsIndividualItemSelected
    {
        get => SelectedCheckInType == "IndividualItem";
        set
        {
            if (value) SelectedCheckInType = "IndividualItem";
            SelectedProduct!.PalletId = "";
            IsItemBoxedCheckChanged(false);
        }
    }
}
    
