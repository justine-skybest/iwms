@page "/receiving/{WarehouseId:int}/add"
@page "/receiving/{WarehouseId:int}/edit/{id:int}"
@rendermode InteractiveServer
@using BlazorBarcodeScanner.ZXing.JS
@using WMS.Frontend.Mapping
@using WMS.Frontend.Models.Receiving

@inject NavigationManager navigationManager
@inject WarehouseClient WarehouseClient
@inject ReceivingClient ReceivingClient
@inject ProductClient ProductClient
@inject PalletClient PalletClient

<PageTitle>@title</PageTitle>

@if(IsLoading)
{
    <div class="full-screen-spinner d-flex justify-content-center align-items-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@if(receiving is null || SelectedProduct is null || Product is null || warehouse is null)
{
     <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
   </div>
}
else
{
    <div class="row ">
        <div class="col-sm-6 ">
            <h2>@title</h2>
        </div>
        <div class="col-sm-6 d-flex justify-content-sm-end align-items-sm-end  mt-sm-0 justify-content-center align-items-center mt-4">
            <h3><i>@warehouse.Name</i></h3>
        </div>
    </div>

    <EditForm Context="FormContext" Model="@receiving" FormName="AddEditWarehouse" OnValidSubmit="HandleSubmitAsync" Enhance>
        <DataAnnotationsValidator/>
        <ValidationSummary/>      
        <fieldset class="border border-1 rounded row p-2 mb-3">    
            <div class="col-md">
                <div class = "mb-2">
                    <label for="TransportCompany" class="form-label">Transport Co.:</label>
                    <InputText id="TransportCompany" @bind-Value="receiving.TransportCompany" class="form-control" onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.TransportCompany"/>
                </div>
                <div class="mb-2">
                    <label for="Shipper" class="form-label">Shipper/Exporter:</label>
                    <InputText id="Shipper" @bind-Value="receiving.Shipper" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.Shipper"/>
                </div>
                <div class="mb-2">
                    <label for="Consignee" class="form-label">Consignee/Importer:</label>
                    <InputText id="Consignee" @bind-Value="receiving.Consignee" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.Consignee"/>
                </div>
            </div>
             <div class="col-md">
                <div class = "mb-2">
                    <label for="DateReceived" class="form-label">Date Received:</label>
                    <InputDate Type="InputDateType.Date" id="DateReceived" @bind-Value="receiving.DateReceived" class="form-control"  onkeypress="return event.keyCode!=13"/>
                    <ValidationMessage For="() => receiving.DateReceived"/>
                </div>
                <div class = "mb-2">
                    <label for="Reference" class="form-label">INV / PO / DR No.</label>
                    <InputTextArea id="Reference" @bind-Value="receiving.Reference" class="form-control" rows="2" />
                    <ValidationMessage For="() => receiving.Reference"/>
                </div>
            </div>
        </fieldset>
        
        <fieldset class="border border-1 row rounded p-2 mb-3">    
            <div class="row p-2">
                <div>
                    <h2><b class="@(String.IsNullOrWhiteSpace(PalletNumbers) ?  "text-danger" : "text-success")">*</b>Pallet #: @PalletNumbers</h2>                    
                </div>                    
                
                <div>
                    <p>Please scan a pallet qr code or generate a new pallet ID.</p>
                    <button class="btn btn-success" type="button"  @onclick="OnShowModalClick">Scan QR Code</button>
                    <button class="btn btn-primary" type="button" @onclick="GeneratePallet">Generate Pallet ID</button>                                       
                </div>
            </div>
        </fieldset>

         <fieldset class="border border-1 row rounded p-2 mb-3">    
            <div class="row p-3">
                <div class="col-md-6 mb-2">
                    <label for="product" class="form-label"><b class="@(String.IsNullOrWhiteSpace(Product.Name) ?  "text-danger" : "text-success")">*</b>Product:</label>
                    <AutoComplete @bind-Value="Product.Name"
                      TItem="ProductSummary"
                      DataProvider="ProductsDataProvider"
                      PropertyName="Name"
                      Placeholder="Search a product" 
                      OnChanged="(ProductSummary product) => OnAutoCompleteChanged(product)"  onkeypress="return event.keyCode!=13"/>                      
                </div>
                <div class="col-md-2 mb-2">
                    <label for="TypeOfPackage" class="form-label">Type of Package:</label>
                    <InputText id="shippier" @bind-Value="Product.TypeOfPackage" class="form-control" readonly  onkeypress="return event.keyCode!=13"/>
                </div>
                <div class="col-md-2 mb-2">
                    <label for="consignee" class="form-label">Measurement:</label>
                    <InputText id="consignee" @bind-Value="Product.Measurement" class="form-control" readonly  onkeypress="return event.keyCode!=13"/>
                </div>
                <div class="col-md-2 mb-2">
                    <label for="Weight" class="form-label">Weight:</label>
                    <InputNumber id="Weight" @bind-Value='Product.Weight' class="form-control" readonly onkeypress="return event.keyCode!=13"/>
                </div>
                <div class="@(IsIndividualItemSelected ? "col-md-4" : "col-md-6") mb-2">
                    <label for="AssignedPallet" class="form-label">
                        <InputCheckbox @bind-Value="IsPalletSelected"/> 
                        @if(SelectedCheckInType.Equals("Pallet"))
                        {
                            <b class="@(String.IsNullOrWhiteSpace(SelectedProduct.PalletId) ?  "text-danger" : "text-success")">*</b>
                        }
                        Palletized 
                        <InputCheckbox @bind-Value="IsIndividualItemSelected"/> 
                        @if(SelectedCheckInType.Equals("IndividualItem"))
                        {
                            <b class="text-success">*</b>                            
                        }
                        Indv. Item                        
                    </label>
                     <InputSelect id="AssignedPallet" @bind-Value="SelectedProduct.PalletId" class="form-select" disabled="@(SelectedCheckInType.Equals("IndividualItem"))">
                        <option value="">Select a pallet</option>
                        @if(pallets is not null)
                        {
                            @foreach (var pallet in pallets.OrderBy(p=> p.PalletNumber))
                            {
                                <option value="@pallet.Id"> Pallet # @pallet.PalletNumber</option>
                            }
                        }
                    </InputSelect>
                    <ValidationMessage For="() => SelectedProduct.PalletId"/>
                </div>
                @if(SelectedCheckInType.Equals("IndividualItem"))
                {
                     <div class="col-md-2 mb-2">
                        <label for="IsItemBoxed" class="form-label">
                            @if(IsBoxed)
                            {
                                <b class="@(String.IsNullOrWhiteSpace(SelectedProduct.ContainerName) ?  "text-danger" : "text-success")">*</b>
                            }
                            <InputCheckbox Value="@IsBoxed" TValue="bool"  ValueExpression="@(() => IsBoxed)" ValueChanged="@IsItemBoxedCheckChanged"/>                        
                            Is Item Boxed?                      
                        </label>        
                        <InputText id="BoxName" @bind-Value="SelectedProduct.ContainerName" class="form-control"  disabled="@(IsBoxed == false)" onkeypress="return event.keyCode!=13" Placeholder="Box Name (Ex. Box 1)" />            
                     </div>                     
                }                
                <div class="col-md-2 mb-2">
                    <label for="Quantity" class="form-label"><b class="@(SelectedProduct.Quantity == 0 ?  "text-danger" : "text-success")">*</b>Quantity:</label>                                        
                    <InputNumber id="Quantity" Value="@SelectedProduct.Quantity" class="form-control" TValue="int" ValueExpression="@(() => SelectedProduct.Quantity)" ValueChanged="@OnQuantityChanged" ParsingErrorMessage="The Quantity must be a whole number."  onkeypress="return event.keyCode!=13"/>
                </div>
                <div class="col-md-2 mb-2">
                    <label for="CBM" class="form-label">
                    @if(IsBoxed){
                        <b class="@(String.IsNullOrEmpty(SelectedProduct.CBM) ?  "text-danger" : "text-success")">*</b>
                    }    
                    CBM:</label>
                    <InputText id="CBM" @bind-Value="SelectedProduct.CBM" class="form-control" readonly="@(IsBoxed == false ? true : false)" onkeypress="return (event.charCode !=8 && event.charCode ==0 || (event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 46 && this.value.indexOf('.') == -1)) && event.keyCode!=13"/>
                </div>
                <div class="col-md-2 mb-2">
                    <label for="TotalWeight" class="form-label">
                    @if(IsBoxed){
                        <b class="@(String.IsNullOrEmpty(SelectedProduct.TotalWeight) ?  "text-danger" : "text-success")">*</b>
                    }
                    Total Weight:</label>
                    <InputText id="TotalWeight" @bind-Value="SelectedProduct.TotalWeight" class="form-control" readonly="@(IsBoxed == false ? true : false)" onkeypress="return (event.charCode !=8 && event.charCode ==0 || (event.charCode >= 48 && event.charCode <= 57) || (event.charCode == 46 && this.value.indexOf('.') == -1)) && event.keyCode!=13"/>
                </div>
                <div class="col-md-4 mb-6">
                    <label for="ExpirationDate" class="form-label"><b class="@(SelectedProduct.ExpirationDate < DateOnly.FromDateTime(DateTime.Now) ?  "text-danger" : "text-success")">*</b>Expiration Date:</label>
                    <InputDate Type="InputDateType.Date" id="ExpirationDate" @bind-Value="SelectedProduct.ExpirationDate" class="form-control"/>
                </div>                
                <div class="col-md-7 mb-6 pr-0">
                    <label for="Remarks" class="form-label"><b class="@(String.IsNullOrWhiteSpace(SelectedProduct.Remarks) ?  "text-danger" : "text-success")">*</b>Remarks:</label>
                    <InputTextArea id="Remarks" @bind-Value="SelectedProduct.Remarks" class="form-control" rows="1" />
                </div>
                <div class="col-md-1 d-flex flex-column flex-md-column justify-content-center align-items-center p-0">                
                    <button style="width:100%;" type="button" @onclick="AppendSelectedProduct" class="btn btn-primary mt-4"><i class="bi bi-clipboard2-plus-fill"></i></button>    
                </div>
                @if(!String.IsNullOrWhiteSpace(DisplayError))
                {   
                    <div class="col pt-3">
                        <Alert Color="AlertColor.Danger"> <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>@DisplayError</Alert>
                    </div>
                }
            </div>
             <div class="row">
               <Grid @ref="ProductGrid"                     
                    TItem="ReceivedProductSummary"                      
                    Data="SelectedProductGrid"
                    Class="table table-hover table-bordered table-striped"
                    AllowPaging="true"
                    PageSize="10"
                    PageSizeSelectorVisible="true"
                    PageSizeSelectorItems="@(new int[] { 5,10,20 })"
                    Responsive="true"
                    Context="GridContext">

                    <GridColumns>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Name">
                            @context.Name
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Type of Package">
                            @context.TypeOfPackage
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Measurement">
                            @context.Measurement
                        </GridColumn>         
                         <GridColumn TItem="ReceivedProductSummary" HeaderText="Box Name">
                            @context.ContainerName
                        </GridColumn>                   
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Quantity">
                            @context.Quantity
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="CBM">
                            @context.CBM                    
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Total">
                            @context.TotalWeight
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Expiration Date">
                            @context.ExpirationDate
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Assigned Pallet">
                            @context.PalletId
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="Remarks">
                            @context.Remarks
                        </GridColumn>
                        <GridColumn TItem="ReceivedProductSummary" HeaderText="">
                            <button class="btn btn-danger" type="button" @onclick="@(()=> GetDeleteModalId(@context))">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </GridColumn>
                    </GridColumns>

                    <GridTemplates>
                        <GridEmptyDataTemplate TItem="ReceivedProductSummary">
                            <div class="text-center">
                                <svg clip-rule="evenodd" fill-rule="evenodd" height="128" stroke-linejoin="round" stroke-miterlimit="2" viewBox="0 0 64 64" width="128" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" id="fi_7486754"><linearGradient id="lg1"><stop offset="0" stop-color="#cadcf0"></stop><stop offset="1" stop-color="#a4bbdb"></stop></linearGradient><linearGradient id="_Linear1" gradientTransform="matrix(40 0 0 25.912 12 48.573)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg1" y1="0" y2="0"></linearGradient><linearGradient id="lg2"><stop offset="0" stop-color="#a4bbdb"></stop><stop offset="1" stop-color="#8da3be"></stop></linearGradient><linearGradient id="_Linear2" gradientTransform="matrix(20.086 0 0 25.912 31.914 48.573)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg2" y1="0" y2="0"></linearGradient><linearGradient id="lg3"><stop offset="0" stop-color="#e9f3fc"></stop><stop offset="1" stop-color="#cadcf0"></stop></linearGradient><linearGradient id="_Linear3" gradientTransform="matrix(14.679 14.768 -21.492 8.973 12.133 35.609)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg3" y1="0" y2=".337"></linearGradient><linearGradient id="_Linear4" gradientTransform="matrix(25.743 1.634 -3.837 17.203 32.081 42.038)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg3" y1="0" y2=".227"></linearGradient><linearGradient id="_Linear5" gradientTransform="matrix(20.007 -6.501 5.236 7.762 9.382 31.736)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg3" y1="0" y2="-.619"></linearGradient><linearGradient id="_Linear6" gradientTransform="matrix(15.249 13.945 -20.61 7.651 37.354 21.357)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg3" y1="0" y2=".429"></linearGradient><linearGradient id="_Linear7" gradientTransform="matrix(40 0 0 13 12 35.606)" gradientUnits="userSpaceOnUse" x1="0" x2="1" xlink:href="#lg1" y1="0" y2="0"></linearGradient><linearGradient id="_Linea