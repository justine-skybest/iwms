@page "/bin"
@page "/warehouse/bin"
@attribute [StreamRendering]

@inject BinClient Client

<PageTitle>Bin</PageTitle>

@if(bins is null)
{
    <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
   </div>
}
else
{
     <div class="d-grid gap-2 d-md-flex justify-content-md-end">        
        <a class="btn btn-primary" type="button" href= "/bin/add">Add New</a>
    </div>
    
    <table class = "table table-striped table-bordered table-hover table-responsive mt-3">
        <thead class="table-dark">
            <th>Name</th>
            <th>Warehouse</th>
            <th>Rack</th>   
            <th>Bay</th>
            <th>Level</th>
            <th style ="width:10%;"></th>
        </thead>
        <tbody>
            @foreach(var bin in bins)
            {
                <tr>
                    <td>@bin.BinName</td>
                    <td>@bin.Warehouse</td>
                    <td>@bin.Rack</td>
                    <td>@bin.Bay</td>
                    <td>@bin.Level</td>
                     <td>
                        <div class="d-flex justify-content-center">
                            <a class="btn btn-primary me-2" role="button" href="@BinUrl(bin.Id)">
                                <i class="bi bi-pencil"></i>
                            </a>
                             <button class ="btn btn-danger" 
                                     data-bs-toggle="modal" 
                                     data-bs-target="@GetDeleteModalId(bin)">
                                <i class="bi bi-x-lg"></i>
                            </button>
                            <DeleteBin bin="@bin"/>       
                        </div>                                  
                    </td>
                </tr>
            }            
        </tbody>
    </table>
}


@code{
    private BinSummary[]? bins;

    protected override async Task OnInitializedAsync()
    {
        bins = await Client.GetBinsAsync();
    } 
    private static string BinUrl(int id) => $"/bin/edit/{id}";
    
    private string GetDeleteModalId(BinSummary bin)
    {
         return $"#{DeleteBin.GetModalId(bin)}";
    }
}