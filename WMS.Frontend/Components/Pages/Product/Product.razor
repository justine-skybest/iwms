@page "/product"

@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject ProductClient ProductClient

<PageTitle>Product</PageTitle>

@if(products is null)
{
     <div class="d-flex justify-content-center">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="d-grid gap-2 d-md-flex justify-content-md-end">        
            <a class="btn btn-success" type="button" href= "/product/add"><i class="bi bi-house-add"></i>
                Add New
            </a>            
    </div>

    <Grid TItem="ProductSummary"
        Class="table table-striped table-bordered table-hover mt-3"
        Data="products"        
            HeaderRowCssClass="bg-secondary text-white border-bottom-0"
            FiltersRowCssClass="bg-dark text-white bg-opacity-25 border-bottom-0" AllowPaging="true" PageSize="10"
            PageSizeSelectorVisible="true" PageSizeSelectorItems="@(new int[] { 5,10,20,30,40,50})" Responsive="true">

        <GridColumns>
            <GridColumn TItem="ProductSummary" HeaderText="Name" PropertyName="Name">
                @context.Name
            </GridColumn>
            <GridColumn TItem="ProductSummary" HeaderText="Type of Package" PropertyName="TypeOfPackage">
                @context.TypeOfPackage
            </GridColumn>
            <GridColumn TItem="ProductSummary" HeaderText="Measurement" PropertyName="Measurement">
                @context.Measurement
            </GridColumn>
            <GridColumn TItem="ProductSummary" HeaderText="Weight" PropertyName="Weight">
                @context.Weight.ToString("N2")
            </GridColumn>
            <GridColumn TItem="ProductSummary" HeaderText="Date Added" PropertyName="DateAdded">
                @context.DateAdded
            </GridColumn>
            <GridColumn TItem="ProductSummary" >
                    <div class="d-flex flex-column flex-sm-row justify-content-center gap-1">                                
                                    <a class="btn btn-primary" role="button" href="@ProductUrl(@context.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class ="btn btn-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="@GetDeleteModalId(@context)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <DeleteProduct product="@context"/>    
                    </div>
            </GridColumn>
        </GridColumns>
    </Grid>

    @* <div class="table-responsive">
          <table class = "table table-striped table-bordered table-hover mt-3">
                <thead class="table-dark align-middle">
                    <th>Name</th>
                    <th>Type of Package</th>
                    <th>Measurement</th>
                    <th>Weight</th>
                    <th style="width:20%">Date Added</th>
                    <th style ="width:10%;"></th>
                </thead>
                <tbody>
                    @foreach(var product in products)
                    {            
                        <tr class="align-middle">
                            <td>@product.Name</td>
                            <td>@product.TypeOfPackage</td>
                            <td>@product.Measurement</td>
                            <td>@product.Weight.ToString("N2")</td>
                            <td class="text-center">@product.DateAdded</td>
                            <td>
                                <div class="d-flex flex-column flex-sm-row justify-content-center gap-1">                                
                                    <a class="btn btn-primary" role="button" href="@ProductUrl(product.Id)">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button class ="btn btn-danger" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="@GetDeleteModalId(product)">
                                        <i class="bi bi-x-lg"></i>
                                    </button>
                                    <DeleteProduct product="@product"/>    
                                </div>                                                                  
                            </td>
                        </tr>
                    }            
                </tbody>
            </table>
    </div>             *@
}

@code {
    
    private ProductSummary[]? products;

    protected override async Task OnInitializedAsync()
    {
        products = await ProductClient.GetProductsAsync();
    }

    private static string ProductUrl(int id) => $"/product/edit/{id}";
        
    private string GetDeleteModalId(ProductSummary product)
    {
        return $"#{DeleteProduct.GetModalId(product)}";
    }  
}
    
