                                            <GridDetailView TItem="CheckedInProductSummary">
                                                <div class="d-flex flex-column flex-md-row justify-content-end">
                                                        <div class="col">
                                                            <div class="row">
                                                                <div class="col-3 fw-bold">Receiving #:</div>
                                                                <div class="col-9">@context.ReceivingSeries</div>
