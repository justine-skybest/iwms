}

<Modal @ref="QRScanner" title="QR Scanner" UseStaticBackdrop="true" CloseOnEscape="false">
    <BodyTemplate>
        <BlazorBarcodeScanner.ZXing.JS.BarcodeReader Title="Scan QR Code from Camera" StartCameraAutomatically="true"
            ShowStart="false" ShowStop="false" ShowResult="false" ShowReset="false" ShowToggleTorch="false"
            ShowVideoDeviceList="true" VideoWidth="300" VideoHeight="200" OnBarcodeReceived="OnScanned" />
        @if (!String.IsNullOrWhiteSpace(OnBinScannedText))
        {
            <div class="col pt-3">
                <Alert Color="AlertColor.Danger">
                    <Icon Name="IconName.ExclamationTriangleFill" class="me-2"></Icon>@OnBinScannedText
                </Alert>
            </div>
        }
    </BodyTemplate>
</Modal>

@code {
    private WarehouseSummary[]? warehouses { get; set; }
    private WarehouseDetails? selectedWarehouse { get; set; }
    private string? WarehouseId { get; set; }
    private string BinNumber = string.Empty;
    private string? OnBinScannedText { get; set; }
    private string? DisplayError { get; set; }    
    private DisplayCheckInProducts[]? checkIns {get;set;}
    private List<IGrouping<string, CheckedInProductSummary>>? boxedGroups { get; set; }        
    private List<CheckedInProductSummary>? loose {get;set;}                
    private CreateManualPicking? forPicking {get;set;}
    private List<PickedProductSummary> PickedProducts {get;set;} = new();
    private Dictionary<string, HashSet<CheckedInProductSummary>> selectedGridItems = new();
    private Modal QRScanner = default!;
    private ConfirmDialog dialog = default!;    

    private bool IsLoading {get;set;} = false;

    protected override async Task OnInitializedAsync()
    {
        warehouses = await WarehouseClient.GetWarehousesAsync();
        forPicking = new(){
            WarehouseId = string.Empty,
            BinId = string.Empty,
            CheckInId = string.Empty         
        };
    }

    private async Task HandleWarehouseChange(string selectedWarehouseId)
    {
        if (!String.IsNullOrWhiteSpace(selectedWarehouseId))
        {            
            WarehouseId = selectedWarehouseId;
            forPicking!.WarehouseId = WarehouseId;
            selectedWarehouse = await WarehouseClient.GetWarehouseAsync(Convert.ToInt32(selectedWarehouseId));
        }
        else
        {
            selectedWarehouse = null;
            WarehouseId = "";
            forPicking!.WarehouseId = string.Empty;
        }
    }

    private async void OnScanned(BarcodeReceivedEventArgs args)
    {
        if (int.TryParse(args.BarcodeText, out int BinHashCode))
        {
            BinSummary existingBin = await BinClient.GetCheckedInBinByHashCodeAsync(BinHashCode, Convert.ToInt32(WarehouseId));
            if(existingBin.Id == 0)
            {
                 OnBinScannedText = existingBin.Warehouse;  //The variable Warehouse was used to store the message from the api.   
            }
            else
            {
                BinNumber = $"{GetLastIndexOf(existingBin.Warehouse, "text")}{GetLastIndexOf(existingBin.Warehouse, "number")}{GetLastIndexOf(existingBin.Rack, "text")}{GetLastIndexOf(existingBin.Rack, "number")}B{existingBin.Bay}L{existingBin.Level}-B{existingBin.BinName.Replace("Bin", "").Replace(" ","")}";
                forPicking!.BinId = Convert.ToString(existingBin.Id);
                checkIns = await BinClient.GetBinStockDetailsAsync(existingBin.Id);           
                if (checkIns != null && checkIns.Any())
                {
                    var checkIn = checkIns.First();  // Assuming you want to work with the first checkIn

                    forPicking.CheckInId = checkIn.Id.ToString();

                    boxedGroups = checkIn.ReceivedProducts
                    .Where(rp => !string.IsNullOrWhiteSpace(rp.ContainerName))
                    .GroupBy(rp => rp.ContainerName)
                    .OrderBy(g => g.Key)
                    .ToList();

                    loose = checkIn.ReceivedProducts
                        .Where(rp => string.IsNullOrWhiteSpace(rp.ContainerName))
                        .ToList(); // No need to change this, since it's fine for loose items
                }        
                await QRScanner.HideAsync();
                StateHasChanged();
            }         
        }
    }
    
    private async Task OnShowModalClick()
    {
        OnBinScannedText = "";
        await QRScanner.ShowAsync();
    }

    private async Task OnHideModalClick()
    {
        await QRScanner.HideAsync();
    }

    private void OnSelectedBoxedItemsChanged(string gridKey, HashSet<CheckedInProductSummary> items)
    {
        // Save the current selection for this grid key
        selectedGridItems[gridKey] = items;

        // Combine all selections from all grids
        var combinedSelectedItems = selectedGridItems.Values.SelectMany(x => x).DistinctBy(x => x.Id).ToList();

        if (PickedProducts == null)
            PickedProducts = new List<PickedProductSummary>();

        // Add or update picked products based on combined selections
        foreach (var item in combinedSelectedItems)
        {
            var existing = PickedProducts.FirstOrDefault(p => p.ReceivedProductId == item.Id.ToString());
            if (existing != null)
            {
                existing.CurrentQuantity = item.Quantity;
                // Update other fields if needed
            }
            else
            {
                PickedProducts.Add(new PickedProductSummary
                {
                    ReceivedProductId = item.Id.ToString(),
                    ProductName = !String.IsNullOrWhiteSpace(item.Name) ? item.Name : "",
                    Source = gridKey,
                    CurrentQuantity = item.Quantity,
                    QuantityPicked = 0,
                    DatePicked = DateTime.Now
                });
            }
        }

        // Remove picked products not in combined selection
        PickedProducts.RemoveAll(p => !combinedSelectedItems.Any(i => i.Id == Convert.ToInt32(p.ReceivedProductId)));
    }


     private void ValidateQuantity(PickedProductSummary product)
    {
        if (product.QuantityPicked < 0)
        {
            product.QuantityPicked = 0; // Reset to 0 if negative value
        }

        if (product.QuantityPicked > product.CurrentQuantity)
        {
            product.QuantityPicked = product.CurrentQuantity; // Max it out to current stock
        }
    }

    private async Task ShowSaveConfirmationAsync()
    {
        // Confirmation dialog setup
        var options = new ConfirmDialogOptions
        {
            YesButtonText = "OK",
            YesButtonColor = ButtonColor.Success,
            NoButtonText = "CANCEL",
            NoButtonColor = ButtonColor.Danger
        };

        // Show the confirmation dialog
        var confirmation = await dialog.ShowAsync(
            title: "Confirmation",
            message1: "Do you want to proceed with the Manual Picking?",
            confirmDialogOptions: options);

        if (confirmation && forPicking is not null)
        {  
            // User clicked "OK", so now we show the loading spinner
            IsLoading = true;
            StateHasChanged();
            
            try
            {
                // Check if any product is picked
                if (PickedProducts is null || !PickedProducts.Any())
                {
                    DisplayError = "You need to select at least one product to proceed.";
                    await ShowErrorForDuration(2000); // Custom error display method
                    return;
                }

                // Validate each product's QuantityPicked
                bool allValid = PickedProducts.All(p => p.QuantityPicked >= 1 && p.QuantityPicked <= p.CurrentQuantity);

                if (!allValid)
                {
                    DisplayError = "Each product must have Quantity Picked of at least 1 and not exceed current quantity.";
                    await ShowErrorForDuration(3000); // Custom error display method
                    return;
                }

                // Proceed with saving the picking information
                forPicking.PickedProducts = PickedProducts.Select(product => new PickedProductDetails(){
                    ReceivedProductId = product.ReceivedProductId,
                    QuantityPicked = product.QuantityPicked,
                    DatePicked = product.DatePicked 
                }).ToList();
                forPicking.PickingDate = DateTime.Now;

                await PickingClient.AddManualPickingAsync(forPicking); 
                
                // Once completed, reset loading state
                IsLoading = false;

                // Refresh the page or redirect
                navigationManager.Refresh(true);
            }
            catch (Exception ex)
            {
                // Handle any errors during the process
                DisplayError = $"An error occurred: {ex.Message}";
                await ShowErrorForDuration(3000);
            }
            finally
            {
                // Make sure to hide the loader if something fails
                IsLoading = false;
            }
        }
    }
    
    private async Task ShowErrorForDuration(int milliseconds)
    {
        var currentError = DisplayError;
        await Task.Delay(milliseconds);
        DisplayError = currentError == DisplayError ? "" : DisplayError; // Clear the error if it hasn't changed
    }

    private string GetLastIndexOf(string text, string returnType)
    {
      // Split the text into words
      var words = text.Split(' ');

      // Check if the last word is numeric
      string lastWord = words.Last();
      bool isLastWordNumber = int.TryParse(lastWord, out int indexNumber);

      // Determine what to return based on returnType
      if (returnType.Equals("text", StringComparison.OrdinalIgnoreCase))
      {
          // Extract the abbreviation from all words except the last one if it's a number
          return string.Concat(
              words.Take(isLastWordNumber ? words.Length - 1 : words.Length)
                  .Select(word => word[0]) // Get the first letter of each word
          );
      }
      else if (returnType.Equals("number", StringComparison.OrdinalIgnoreCase) && isLastWordNumber)
      {
          // Return the number if it's a valid integer
          return lastWord;
      }

      // Fallback to an empty string if no valid returnType is provided
      return string.Empty;
    }
}
