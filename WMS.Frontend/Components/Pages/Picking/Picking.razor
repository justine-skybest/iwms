@page "/manualpicking"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inject NavigationManager navigationManager
@inject WarehouseClient WarehouseClient
@inject BinClient BinClient
@inject CheckInClient CheckInClient
@inject ManualPickingClient PickingClient

<PageTitle>Manual Picking</PageTitle>

